# Database — use SQLite for local dev, swap to PostgreSQL for prod
DATABASE_URL=sqlite+aiosqlite:///./campusdesk.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/campusdesk

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Email (Ethereal for dev — get creds at https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
EMAIL_FROM=campusdesk@lnmiit.ac.in

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173
